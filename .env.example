# Copy to .env.local and fill in.
# Local values come from `supabase status` after `supabase start`.
# Hosted values: Supabase dashboard > Project Settings > API.

# Project URL (local default: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public anon key. Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
# Used for signed audio URLs and by scripts/verify-schema.ts.
SUPABASE_SERVICE_ROLE_KEY=
