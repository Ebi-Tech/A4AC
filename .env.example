# Copy to .env.local and fill in.
# Local values come from `supabase status -o env` after `supabase start`.
# Hosted values: Supabase dashboard > Project Settings > API.

# Project URL (local default: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public anon key. Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
# Used for signed audio URLs, account deletion and the verify scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the site, used in sign-in redirects.
# Optional locally (defaults to the request's origin); set it in production,
# e.g. https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google sign-in (optional). Leave empty to hide the Google button.
# The same values must be configured in Supabase: dashboard > Authentication >
# Providers > Google (hosted), or supabase/.env + config.toml (local).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
